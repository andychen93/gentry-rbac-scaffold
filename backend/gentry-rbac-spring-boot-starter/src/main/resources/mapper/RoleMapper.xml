<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gentry.rbac.role.mapper.RoleMapper">

    <resultMap id="RoleResultMap" type="com.gentry.rbac.role.entity.Role">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="roleCode" column="role_code"/>
        <result property="roleName" column="role_name"/>
        <result property="dataScope" column="data_scope"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="listCondition">
        WHERE r.tenant_id = #{tenantId} AND r.deleted = 0
        <if test="roleName != null and roleName != ''">
            AND r.role_name LIKE CONCAT('%', #{roleName}, '%')
        </if>
        <if test="roleCode != null and roleCode != ''">
            AND r.role_code = #{roleCode}
        </if>
        <if test="status != null">
            AND r.status = #{status}
        </if>
    </sql>

    <select id="selectPageList" resultType="map">
        SELECT r.id, r.role_code AS "roleCode", r.role_name AS "roleName",
               r.data_scope AS "dataScope", r.sort, r.status, r.remark,
               r.create_time AS "createTime",
               COALESCE(uc.user_count, 0) AS "userCount"
        FROM sys_role r
        LEFT JOIN (
            SELECT role_id, COUNT(*) AS user_count
            FROM sys_user_role
            GROUP BY role_id
        ) uc ON uc.role_id = r.id
        <include refid="listCondition"/>
        ORDER BY r.sort ASC, r.create_time ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM sys_role r
        <include refid="listCondition"/>
    </select>



    <select id="selectRoleById" resultMap="RoleResultMap">
        SELECT * FROM sys_role WHERE id = #{id} AND deleted = 0
    </select>

</mapper>
