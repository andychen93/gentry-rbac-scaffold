<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gentry.rbac.dict.mapper.DictDataMapper">

    <resultMap id="DictDataResultMap" type="com.gentry.rbac.dict.entity.DictData">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="dictType" column="dict_type"/>
        <result property="dictLabel" column="dict_label"/>
        <result property="dictValue" column="dict_value"/>
        <result property="cssClass" column="css_class"/>
        <result property="listClass" column="list_class"/>
        <result property="isDefault" column="is_default"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <select id="selectByDictType" resultMap="DictDataResultMap">
        SELECT * FROM sys_dict_data
        WHERE tenant_id = #{tenantId} AND dict_type = #{dictType} AND status = 1 AND deleted = 0
        ORDER BY sort ASC, id ASC
    </select>


</mapper>
