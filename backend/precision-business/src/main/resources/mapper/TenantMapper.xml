<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.precision.rbac.tenant.mapper.TenantMapper">

    <resultMap id="TenantResultMap" type="com.precision.rbac.tenant.entity.Tenant">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="contact" column="contact"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="address" column="address"/>
        <result property="logo" column="logo"/>
        <result property="domain" column="domain"/>
        <result property="packageId" column="package_id"/>
        <result property="expireTime" column="expire_time"/>
        <result property="accountLimit" column="account_limit"/>
        <result property="deviceLimit" column="device_limit"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="config" column="config"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <resultMap id="TenantListVOMap" type="com.precision.rbac.tenant.vo.TenantListVO">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="contact" column="contact"/>
        <result property="phone" column="phone"/>
        <result property="userCount" column="user_count"/>
        <result property="deviceCount" column="device_count"/>
        <result property="expireTime" column="expire_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap id="TenantStatisticsMap" type="com.precision.rbac.tenant.vo.TenantStatistics">
        <result property="userCount" column="user_count"/>
        <result property="deptCount" column="dept_count"/>
        <result property="roleCount" column="role_count"/>
    </resultMap>



    <sql id="queryCondition">
        WHERE t.deleted = 0
        <if test="query.name != null and query.name != ''">
            AND t.name LIKE CONCAT('%', #{query.name}, '%')
        </if>
        <if test="query.code != null and query.code != ''">
            AND t.code = #{query.code}
        </if>
        <if test="query.contact != null and query.contact != ''">
            AND t.contact LIKE CONCAT('%', #{query.contact}, '%')
        </if>
        <if test="query.phone != null and query.phone != ''">
            AND t.phone = #{query.phone}
        </if>
        <if test="query.status != null">
            AND t.status = #{query.status}
        </if>
    </sql>

    <select id="selectList" resultMap="TenantListVOMap">
        SELECT t.id, t.code, t.name, t.contact, t.phone, t.expire_time, t.status, t.create_time,
            COALESCE(uc.user_count, 0) AS user_count,
            0 AS device_count
        FROM sys_tenant t
        LEFT JOIN (
            SELECT tenant_id, COUNT(*) AS user_count
            FROM sys_user WHERE deleted = 0
            GROUP BY tenant_id
        ) uc ON uc.tenant_id = t.id
        <include refid="queryCondition"/>
        ORDER BY t.create_time DESC
        LIMIT #{query.pageSize} OFFSET #{query.offset}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM sys_tenant t
        <include refid="queryCondition"/>
    </select>

    <select id="selectStatistics" resultMap="TenantStatisticsMap">
        SELECT
            (SELECT COUNT(*) FROM sys_user WHERE tenant_id = #{tenantId} AND deleted = 0) AS user_count,
            (SELECT COUNT(*) FROM sys_dept WHERE tenant_id = #{tenantId} AND deleted = 0) AS dept_count,
            (SELECT COUNT(*) FROM sys_role WHERE tenant_id = #{tenantId} AND deleted = 0) AS role_count
    </select>

</mapper>
