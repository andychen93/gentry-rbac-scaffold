<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.precision.rbac.user.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.precision.rbac.user.entity.User">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="gender" column="gender"/>
        <result property="postName" column="post_name"/>
        <result property="avatar" column="avatar"/>
        <result property="deptId" column="dept_id"/>
        <result property="status" column="status"/>
        <result property="loginIp" column="login_ip"/>
        <result property="loginDate" column="login_date"/>
        <result property="pwdUpdateTime" column="pwd_update_time"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>



    <sql id="queryCondition">
        WHERE u.tenant_id = #{tenantId} AND u.deleted = 0
        <if test="query.username != null and query.username != ''">
            AND u.username LIKE CONCAT('%', #{query.username}, '%')
        </if>
        <if test="query.phone != null and query.phone != ''">
            AND u.phone = #{query.phone}
        </if>
        <if test="query.status != null">
            AND u.status = #{query.status}
        </if>
        <if test="deptIds != null and deptIds.size() > 0">
            AND u.dept_id IN
            <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
                #{deptId}
            </foreach>
        </if>
    </sql>

    <select id="selectList" resultMap="UserResultMap">
        SELECT u.* FROM sys_user u
        <include refid="queryCondition"/>
        ORDER BY u.create_time DESC
        LIMIT #{query.pageSize} OFFSET #{query.offset}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM sys_user u
        <include refid="queryCondition"/>
    </select>

</mapper>
